# Credentials are read from the environment, never from the config file.
# Copy to .env and source it, or put these in your launchd/cron job's environment.

# seats.aero Partner API key (NOT a Pro website subscription).
SEATS_AERO_API_KEY=

# Telegram: create a bot with @BotFather, put the token here, send the bot a message,
# then run `flightwatch telegram-setup` to discover your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack incoming webhook URL.
SLACK_WEBHOOK_URL=

# SMTP. For Gmail use an app password, not your account password.
SMTP_USERNAME=
SMTP_PASSWORD=
